# Node --env-file=.env src/server.js explicitly loads this file. Nothing loads it implicitly.
BLOG_ORIGIN=http://localhost:4300
BLOG_HOST=127.0.0.1
BLOG_PORT=4300
BLOG_MODE=development
BLOG_TITLE=示例小站
BLOG_DESCRIPTION=记录生活，也分享灵感。
BLOG_THEME=system
# Relative, dedicated directory below the project root. Never point at an existing system.
BLOG_DATA_DIR=var

# Optional local design JSON filename (defaults to design.json).
BLOG_DESIGN_FILE=design.json
